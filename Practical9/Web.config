<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="PlacementDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=PlacementDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Web.Extensions" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>
