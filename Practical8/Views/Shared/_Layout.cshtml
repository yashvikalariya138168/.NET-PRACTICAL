<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Practical8</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7fb;
            color: #263445;
        }

        .navbar {
            background: #172554;
            padding: 17px 6%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 3px 12px rgba(0,0,0,.12);
        }

        .brand {
            color: white;
            font-size: 21px;
            font-weight: bold;
            text-decoration: none;
        }

        .nav-link {
            color: #dbeafe;
            text-decoration: none;
            font-size: 15px;
        }

            .nav-link:hover {
                color: white;
            }

        .main-content {
            width: 90%;
            max-width: 1150px;
            min-height: 65vh;
            margin: 35px auto;
        }

        .footer {
            border-top: 1px solid #d8dee8;
            padding: 20px 5%;
            color: #64748b;
            text-align: center;
            font-size: 14px;
        }

        @@media (max-width: 600px) {
            .navbar {
                padding: 15px 5%;
            }

            .brand {
                font-size: 18px;
            }

            .main-content {
                width: 94%;
                margin: 20px auto;
            }
        }
    </style>
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />
</head>
<body>

    <nav class="navbar">
        <a href="@Url.Action("Index", "Products")" class="brand">
            Practical8 | Inventory
        </a>

        <a href="@Url.Action("Index", "Products")" class="nav-link">
            Products
        </a>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        &copy; @DateTime.Now.Year - Practical8 Inventory Management System
    </footer>

</body>
</html>