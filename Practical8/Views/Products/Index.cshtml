@model IEnumerable<Practical8.Models.Product>

@{
    ViewBag.Title = "Products";
}

<div class="page-card">

    <h2 class="page-title">Inventory Management System</h2>

    <p>
        @Html.ActionLink("+ Add New Product", "Create", null,
            new { @class = "btn-custom btn-add" })
    </p>

    <div class="table-wrapper">
        <table class="product-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductId</td>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>₹@item.Price</td>
                        <td>@item.Category</td>

                        <td>
                            <div class="action-buttons">

                                @Html.ActionLink("Edit", "Edit",
                                    new { id = item.ProductId },
                                    new { @class = "btn-custom btn-edit" })

                                @using (Html.BeginForm("Delete", "Products",
                                    new { id = item.ProductId }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn-custom btn-delete"
                                            onclick="return confirm('Are you sure you want to delete this product?');">
                                        Delete
                                    </button>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>